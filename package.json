{
  "type": "module",
  "name": "timnas-performance-hub",
  "version": "1.19.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js tests/db/*.test.js tests/web/*.test.js && npm run test:donny",
    "test:db": "node --test tests/db/*.test.js",
    "test:web": "node --test tests/web/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node tools/build.mjs",
    "build:web": "node tools/build.mjs --web",
    "demo": "node tools/gen_pubgm_demo.mjs",
    "pretest": "node tools/build.mjs",
    "test:donny": "vitest run --root vendor/donny-monitoring"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^24.1.3",
    "pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
