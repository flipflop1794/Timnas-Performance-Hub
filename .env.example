# Copy to .env for a local website build (never commit .env). In production these live in Vercel → Settings → Environment Variables.
# Both values are public by design (they ship to browsers); access is enforced by Supabase Row Level Security.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NEVER put the service_role / secret key here or in Vercel: the build refuses it.
